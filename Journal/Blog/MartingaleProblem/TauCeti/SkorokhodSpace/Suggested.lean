    (ε := 2 * ε) (by linarith) ?_ ?_ ?_
  · intro s hs
    have hy : l.toOrderIso s ∈ Set.Icc (t 0) (t (Fin.last n)) := by
      have hmem : l.toOrderIso s ∈ exhaustion t₀ M := exhaustion_subset_of_le t₀ huM hs
      exact ⟨ht0.trans ((isLeast_exhaustionMin t₀ M).2 hmem),
