      Filter.Tendsto (fun n => Real.exp (-u) *
          min 1 (SkorokhodSpace.distWith t₀ u (κ n) (x n) z))
        Filter.atTop (𝓝 ((fun _ : ℝ => (0 : ℝ)) u)) := by
