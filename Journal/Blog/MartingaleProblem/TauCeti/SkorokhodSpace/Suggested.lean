        have := hs
        simp only [exhaustion, Metric.mem_closedBall, max_eq_left hu] at this
        rwa [dist_comm]
      have h3 : (((κ n)⁻¹).norm) = (κ n).norm := TimeChange.norm_inv (κ n)
      rw [h3] at h1
