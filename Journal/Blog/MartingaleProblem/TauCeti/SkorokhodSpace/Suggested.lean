    rcases le_or_gt a b with hab | hab
    · exact le_of_eq (sub_lengthCoord_of_le t₀ hab)
    · have h1 := (strictMono_lengthCoord (ι := ι) t₀) hab
      have h2 : (0 : ℝ) ≤ dist a b := dist_nonneg
      linarith
