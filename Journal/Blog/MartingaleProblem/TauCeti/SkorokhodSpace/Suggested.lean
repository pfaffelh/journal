    have hsmem : s ∈ exhaustion t₀ (m : ℝ) := by
      have h1 := TimeChange.dist_le_exp_norm_mul ((κ n)⁻¹) t₀ ((κ n).toOrderIso s)
      rw [hinv n] at h1
      simp only [OrderIso.symm_apply_apply] at h1
      have hft : (κ n).toOrderIso.symm t₀ = t₀ := by rw [← hinv n]; exact hinvfix n
      rw [hft] at h1
