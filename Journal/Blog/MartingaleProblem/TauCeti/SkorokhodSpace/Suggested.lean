    filter_upwards with u
    have h0 : (0 : ℝ) ≤ min 1 (SkorokhodSpace.distWith t₀ u (κ n) (x n) z) :=
      le_min zero_le_one (SkorokhodSpace.distWith_nonneg t₀ u (κ n) (x n) z)
